{
  "name": "byline-indexer",
  "version": "1.0.0",
  "description": "Real-time on-chain activity indexer for Byline - polls Soroban RPC for purchase events and stores in SQLite",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "lint": "eslint src --ext ts",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "soroban",
    "stellar",
    "indexer",
    "blockchain",
    "activity-feed"
  ],
  "author": "Byline",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "sqlite3": "^5.1.6",
    "pino": "^8.17.2",
    "stellar-sdk": "^12.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.11",
    "@typescript-eslint/eslint-plugin": "^6.20.0",
    "@typescript-eslint/parser": "^6.20.0",
    "eslint": "^8.56.0",
    "pino-pretty": "^10.3.1",
    "tsx": "^4.17.0",
    "typescript": "^5.6.2",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
